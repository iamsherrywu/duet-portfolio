# Copy this template to .env.local; fill locally, never commit the filled file.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Use a provider supporting the Chat Completions JSON interface.
# Include its API prefix (for example /v1); no trailing /chat/completions.
# For local development only, Ollama runs on the same machine as Next.js:
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=qwen3-vl:8b
# AI_VISION_MODEL=qwen3-vl:8b
# For a hosted Duet site, configure a cloud model endpoint or a model server
# reachable by the app server; these values are server-side only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
# Server-only secret used by the scheduled story cleanup task.
CRON_SECRET=

# AMap Web JS API key and server-only security code
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
